--// Accurate Analytic Quadratic Bullet Intercept Solver (Universal Ballistics Engine)
local function GetInterceptPosition(shooterPos, targetPos, targetVel, bulletSpeed)
    local r = targetPos - shooterPos
    local v = targetVel
    
    local a = v.Magnitude^2 - bulletSpeed^2
    local b = 2 * r:Dot(v)
    local c = r.Magnitude^2
    
    local discriminant = (b * b) - (4 * a * c)
    if discriminant < 0 then
        return nil
    end
    
    local sqrtDisc = math.sqrt(discriminant)
    local t1 = (-b - sqrtDisc) / (2 * a)
    local t2 = (-b + sqrtDisc) / (2 * a)
    
    local t = nil
    if t1 > 0 and t2 > 0 then
        t = math.min(t1, t2)
    elseif t1 > 0 then
        t = t1
    elseif t2 > 0 then
        t = t2
    else
        return nil
    end
    
    if t > 4.5 then
        return nil
    end
    
    return targetPos + (v * t), t
end

local function GetClosestPlayer()
    local MaximumDistance = Settings.MaxDistance
    local TargetPlayer = nil
    local BestPredictedPos = nil
    
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return nil, nil end
    local MyPos = LocalPlayer.Character.HumanoidRootPart.Position
    local MousePos = UserInputService:GetMouseLocation()
    Camera = workspace.CurrentCamera

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local targetHumanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if targetHumanoid and targetHumanoid.Health > 0 then
                
                if player.Team ~= nil and LocalPlayer.Team ~= nil then
                    if player.Team == LocalPlayer.Team or player.TeamColor == LocalPlayer.TeamColor then continue end
                end
                
                local hitPart = player.Character:FindFirstChild(Settings.TargetPart) or player.Character:FindFirstChild("HumanoidRootPart")
                local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
                if hitPart and rootPart then
                    local targetVel = rootPart.AssemblyLinearVelocity or rootPart.Velocity or Vector3.new(0,0,0)
                    
                    local predictedPos, interceptTime = GetInterceptPosition(MyPos, hitPart.Position, targetVel, Settings.BulletSpeed)
                    
                    if predictedPos and interceptTime then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(predictedPos)
                        if onScreen then
                            local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - MousePos).Magnitude
                            if screenDist <= Settings.FOVRadius then
                                local Distance = (predictedPos - MyPos).Magnitude
                                if Distance < MaximumDistance then
                                    if Settings.WallCheck then
                                        local Parts = Camera:GetPartsObscuringTarget({predictedPos}, {LocalPlayer.Character, player.Character})
                                        if #Parts > 0 then continue end
                                    end
                                    
                                    MaximumDistance = Distance
                                    TargetPlayer = player
                                    BestPredictedPos = predictedPos
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return TargetPlayer, BestPredictedPos
end

