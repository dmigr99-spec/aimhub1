--// Render Loop with Bullet Intercept Validation & Smooth Damping
RunService:BindToRenderStep("AimLockCameraUpdate", Enum.RenderPriority.Camera.Value + 1, function(deltaTime)
    pcall(function()
        deltaTime = deltaTime or 0.016 
        Camera = workspace.CurrentCamera

        if FOVCircle then
            FOVCircle.Position = UserInputService:GetMouseLocation()
            if Settings.Enabled and Aiming and Settings.FOVPulse then
                local pulseOffset = math.sin(tick() * 6) * (Settings.FOVRadius * 0.06)
                FOVCircle.Radius = Settings.FOVRadius + pulseOffset
                FOVCircle.Transparency = 0.5 + (math.sin(tick() * 6) * 0.5)
            else
                FOVCircle.Radius = Settings.FOVRadius
                FOVCircle.Transparency = 1
            end
            FOVCircle.Visible = Settings.Enabled and Settings.ShowFOV
        end
        
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local highlight = player.Character:FindFirstChild("TestESP_Highlight")
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                
                if Settings.Enabled and Settings.ESPEnabled and hum and hum.Health > 0 and not (player.Team ~= nil and LocalPlayer.Team ~= nil and (player.Team == LocalPlayer.Team or player.TeamColor == LocalPlayer.TeamColor)) then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "TestESP_Highlight"
                        highlight.OutlineTransparency = 0.2
                        highlight.Parent = player.Character
                    end
                    highlight.FillTransparency = Settings.ESPTransparency
                    local col = player.TeamColor and player.TeamColor.Color or Styles.Accent
                    highlight.FillColor = col
                    highlight.OutlineColor = col
                else
                    if highlight then highlight:Destroy() end
                end
            end
        end
        
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

        if Settings.Enabled and Aiming and myRoot then
            local isTargetValid = false
            local predictedPosition = nil
            
            if Target and Target.Character and Target.Character:FindFirstChild("HumanoidRootPart") then
                local targetHum = Target.Character:FindFirstChildOfClass("Humanoid")
                if targetHum and targetHum.Health > 0 then
                    if not (Target.Team ~= nil and LocalPlayer.Team ~= nil and (Target.Team == LocalPlayer.Team or Target.TeamColor == LocalPlayer.TeamColor)) then
                        local hitPart = Target.Character:FindFirstChild(Settings.TargetPart) or Target.Character:FindFirstChild("HumanoidRootPart")
                        local rootPart = Target.Character:FindFirstChild("HumanoidRootPart")
                        
                        if hitPart and rootPart then
                            local targetVel = rootPart.AssemblyLinearVelocity or rootPart.Velocity or Vector3.new(0,0,0)
                            local validPos, interceptTime = GetInterceptPosition(myRoot.Position, hitPart.Position, targetVel, Settings.BulletSpeed)
                            
                            if validPos and interceptTime then
                                predictedPosition = validPos
                                local screenPos, onScreen = Camera:WorldToViewportPoint(predictedPosition)
                                local mousePos = UserInputService:GetMouseLocation()
                                local distanceFromMouse = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                                local dist3D = (predictedPosition - myRoot.Position).Magnitude
                                
                                if onScreen and distanceFromMouse <= (Settings.FOVRadius * 1.8) and dist3D <= Settings.MaxDistance then
                                    if not Settings.WallCheck or #Camera:GetPartsObscuringTarget({predictedPosition}, {myChar, Target.Character}) == 0 then
                                        isTargetValid = true
                                    end
                                end
                            end
                        end
                    end
                end
            end

            if not isTargetValid then 
                Target, predictedPosition = GetClosestPlayer()
            else
                local hitPart = Target.Character:FindFirstChild(Settings.TargetPart) or Target.Character:FindFirstChild("HumanoidRootPart")
                local rootPart = Target.Character:FindFirstChild("HumanoidRootPart")
                if hitPart and rootPart then
                    local targetVel = rootPart.AssemblyLinearVelocity or rootPart.Velocity or Vector3.new(0,0,0)
                    predictedPosition = GetInterceptPosition(myRoot.Position, hitPart.Position, targetVel, Settings.BulletSpeed)
                end
            end
            
            if Target and Target.Character and predictedPosition then
                local HitPart = Target.Character:FindFirstChild(Settings.TargetPart) or Target.Character:FindFirstChild("HumanoidRootPart")
                if HitPart then
                    if Settings.TargetIndicator and TargetDot then
                        local pos, onScreen = Camera:WorldToViewportPoint(predictedPosition)
                        if onScreen then
                            TargetDot.Position = Vector2.new(pos.X, pos.Y)
                            TargetDot.Visible = true
                        else TargetDot.Visible = false end
                    elseif TargetDot then TargetDot.Visible = false end

                    if Target ~= LastLoggedTarget then
                        SystemLogEvent("Intercept Lock Acquired: " .. Target.DisplayName)
                        LastLoggedTarget = Target
                    end
                    
                    local currentHp = Target.Character:FindFirstChildOfClass("Humanoid") and Target.Character:FindFirstChildOfClass("Humanoid").Health or 0
                    if currentHp <= 0 and LastTargetHealth > 0 then
                        SystemLogEvent("Target Eliminated: " .. Target.DisplayName)
                        LastLoggedTarget = nil 
                    end
                    LastTargetHealth = currentHp

                    local TargetLook = CFrame.lookAt(Camera.CFrame.Position, predictedPosition)
                    local rawSmoothness = math.clamp(Settings.Smoothness / 100, 0.001, 1)
                    local fpsAdjustedAlpha = 1 - math.pow(1 - rawSmoothness, deltaTime * 60)
                    Camera.CFrame = Camera.CFrame:Lerp(TargetLook, fpsAdjustedAlpha)

                    if Settings.AutoShoot and not IsShooting then
                        IsShooting = true
                        task.spawn(function()
                            local rate = FireRates[Settings.ShootMode] or FireRates.Normal
                            while Aiming and Target and Settings.AutoShoot do
                                ControlClick(true)
                                task.wait(rate.press)
                                if not (Aiming and Target and Settings.AutoShoot) then break end
                                ControlClick(false)
                                task.wait(rate.release)
                            end
                            ControlClick(false)
                            IsShooting = false
                        end)
                    end
                end
            else
                Target = nil
                if TargetDot then TargetDot.Visible = false end
                if IsShooting then IsShooting = false ControlClick(false) end
            end
        else
            Target = nil
            if TargetDot then TargetDot.Visible = false end
            LastLoggedTarget = nil
            if IsShooting then IsShooting = false ControlClick(false) end
        end
    end)
end)

